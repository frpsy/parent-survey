rules_version = '2';

// 학부모 조사함 Firestore 보안 규칙
// - 조사(surveys): 누구나 읽기, 관리자만 쓰기
// - 응답(responses): 익명 로그인한 본인만 자기 응답 1건을 쓰고 고침(조사가 열려 있을 때만)
// - 전체 응답 읽기: 관리자, 또는 "결과 공개"로 만든 조사
// 아래 관리자 이메일을 js/config.js 의 adminEmails 와 똑같이 바꿔 주세요.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['YOUR_EMAIL@gmail.com'];
    }

    // 학부모 명단: 관리자만 (공개 사이트에서 읽히지 않음)
    match /rosters/{groupId} {
      allow read, write: if isAdmin();
    }

    match /surveys/{surveyId} {
      allow read: if true;
      allow write: if isAdmin();

      function survey() {
        return get(/databases/$(database)/documents/surveys/$(surveyId)).data;
      }

      function surveyOpen() {
        let s = survey();
        return s.status == 'open'
          && (s.get('deadlineMs', null) == null || request.time.toMillis() < s.deadlineMs);
      }

      function validResponse(uid) {
        let d = request.resource.data;
        return d.keys().hasOnly(['uid', 'name', 'answers', 'updatedAt'])
          && d.uid == uid
          && d.name is string && d.name.size() > 0 && d.name.size() <= 30
          && d.answers is map
          && d.updatedAt is number;
      }

      match /responses/{uid} {
        allow get: if isAdmin()
          || (request.auth != null && request.auth.uid == uid)
          || survey().get('publicResults', false) == true;
        allow list: if isAdmin() || survey().get('publicResults', false) == true;
        allow create, update: if request.auth != null && request.auth.uid == uid
          && surveyOpen() && validResponse(uid);
        allow delete: if isAdmin()
          || (request.auth != null && request.auth.uid == uid && surveyOpen());
      }
    }
  }
}
